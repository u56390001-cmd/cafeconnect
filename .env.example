# ---------------------------------------------------------------------------
# Public app configuration - safe for browser exposure
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-app-id

# ---------------------------------------------------------------------------
# Firebase Admin SDK - server-only
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=replace-with-project
FIREBASE_CLIENT_EMAIL=replace-with-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Secret encryption - server-only
# ---------------------------------------------------------------------------
SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-master-key
SECRET_ENCRYPTION_KEY_VERSION=1

# ---------------------------------------------------------------------------
# Gemini AI - server-only
# ---------------------------------------------------------------------------
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API - server-only
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
META_GRAPH_API_VERSION=v20.0

# ---------------------------------------------------------------------------
# QR trial provider - server-only
# ---------------------------------------------------------------------------
QR_PROVIDER_BASE_URL=https://whatsapp.qasimhussain.com
QR_PROVIDER_API_KEY=replace-with-qr-provider-api-key
QR_PROVIDER_WEBHOOK_SECRET=replace-with-qr-provider-webhook-secret
QR_PROVIDER_WEBHOOK_BASE_URL=replace-with-public-site-url

# ---------------------------------------------------------------------------
# Background worker / cron - server-only
# ---------------------------------------------------------------------------
# Authenticates GET /api/cron/whatsapp (Vercel Cron sends it as
# Authorization: Bearer <CRON_SECRET>; external schedulers may send the
# x-cron-secret header instead).
CRON_SECRET=replace-with-long-random-string

