rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product images are written and read only through the server
    // (Firebase Admin SDK in src/app/api/menu/items/*/images and
    // src/app/api/media/[assetId]). Direct client access is denied, so no
    // public URL can be guessed, reused across tenants or deleted by a user.
    match /tenants/{tenantId}/menu-items/{itemId}/{fileName} {
      allow read, write: if false;
    }

    // Everything else in the bucket is server-only as well.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
