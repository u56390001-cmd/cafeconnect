rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // CafeConnect reads and writes all tenant data through the Firebase
    // Admin SDK on the server (see src/lib/tenancy/resolver.ts), which
    // bypasses these rules and performs its own authorization
    // (requireTenantScope + role checks).
    //
    // The client SDK is only used for authentication, so client access to
    // tenant data is denied by default. Keeping the rules deny-by-default
    // removes the previous mismatch with custom claims the app never set.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // Identity document of the signed-in user only.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Public, non-sensitive widget metadata (never credentials).
    match /tenants/{tenantId}/settings/publicWidget/{widgetId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else (tenants, members, menu, offers, orders, bookings,
    // conversations, messages, knowledge, apiKeys, customers, memories,
    // reminders, carts, rate limits) is server-only.
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if false;
    }

    // Platform internals are server-only.
    match /platform/{document=**} {
      allow read, write: if false;
    }

    // Storage paths are not used yet; deny by default.
    match /storage/{path=**} {
      allow read, write: if false;
    }
  }
}
